      "name": "02 | Create FRIENDS SPLIT and invite",
      "description": "If visit code absent, stop and check create response; this flow does not invent codes.",
      "item": [
        {
          "name": "02.01 | Create visit",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/visit/create",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"SIKKA-SPLIT-QA-{{runTag}}\",\n  \"groupName\": \"Sikka QA Split\",\n  \"visitDate\": \"{{visitDate}}\",\n  \"maxParticipants\": 2,\n  \"tripType\": \"FRIENDS\",\n  \"togetherMode\": \"SPLIT\",\n  \"durationMinutes\": 480,\n  \"primaryGoal\": \"MAX_RIDES\",\n  \"includePrayer\": false\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Server response is message with invite code; capture it. Validate code before proceeding."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Expected status\",()=>pm.expect([200]).to.include(pm.response.code));",
                  "if(pm.response.code>=200&&pm.response.code<300){const data=pm.response.json(); const v=(data.message||\"\").match(/invite code:\\s*(.+)$/i)?.[1]?.trim();if(v!==undefined&&v!==null)pm.environment.set(\"inviteCode\",String(v));}"
                ]
              }
            }
          ]
        },
